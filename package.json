{
	"name": "{{ remrg:var project-name }}",
	"version": "1.0.0",
	"description": "",
	"author": "{{ remrg:var organization }}",
	"license": "{{ remrg:var license }}",
	"main": "dist/main/index.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-vite build",
		"build:web": "vite build",
		"dev": "electron-vite dev",
		"dev:web": "vite",
		"preview": "vite preview",
		"preview:desktop": "electron-vite preview",
		"package": "npm run build && electron-builder --dir",
		"dist": "npm run build && electron-builder",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
		"lint": "eslint . --fix && prettier --write .",
		"lint:check": "prettier --check . && eslint .",
		"test": "npm run lint && npm run typecheck && npm run test:run",
		"test:ci": "npm run lint:check && npm run typecheck && npm run test:run",
		"test:dev": "vitest --ui --coverage",
		"test:run": "vitest run --coverage && npm run test:e2e && npm run test:desktop",
		"test:e2e": "playwright test",
		"test:desktop": "npm run build && playwright test --config playwright.electron.config.ts",
		"test:dev:e2e": "playwright test --ui"
	},
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=10.8.2"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.43.0",
		"@types/node": "^22.19.17",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"@vitest/coverage-v8": "^4.1.2",
		"@vitest/ui": "^4.1.2",
		"eslint": "^10.1.0",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.1",
		"prettier-plugin-brace-style": "^0.10.1",
		"terser": "^5.46.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^4.1.2"
	}
}
